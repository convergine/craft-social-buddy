{% extends 'convergine-socialbuddy/_layouts/_settings' %}
{% do view.registerAssetBundle("convergine\\socialbuddy\\assets\\BuddyAssets") %}
{% import '_includes/forms' as forms %}

{% set title = 'Settings' %}
{% set selectedSubnavItem = 'settings' %}

{% set fullPageForm = true %}

{% block content %}
    <h2>Telegram</h2>
    <input type="hidden" name="action" value="plugins/save-plugin-settings">
    <input type="hidden" name="pluginHandle" value="convergine-socialbuddy">
    {% namespace 'settings' %}


        {% if settings.license != 'pro' %}

        <div class="warning" style="padding: 20px; background: #fff4e5; border: 1px solid #ffd9b3; border-radius: 4px; color: #663d00;">

        This social platform is included in PRO versions of the plugin. Please upgrade at <a href="https://plugins.craftcms.com">plugins.craftcms.com</a>

        </div>

        {% else %}

        <p>
            To set up Telegram integration, you'll need to:
            <ol>
                <li>Create a Telegram bot by messaging <a href="https://t.me/botfather" target="_blank">@BotFather</a></li>
                <li>Get your bot token from BotFather</li>
                <li>Add your bot as an admin to your Telegram channel</li>
                <li>Enter your channel name (without @) and bot token below</li>
            </ol>
        </p>

        {{ forms.autosuggestField({
            label: 'Telegram Channel Name'|t('convergine-socialbuddy'),
            name: 'telegramChannelAccount',
            value: settings.telegramChannelAccount,
            instructions: 'Channel where posts will be published to. Please specify the name without leading @ symbol'|t('convergine-socialbuddy'),
            suggestEnvVars: true,
        }) }}

        {{ forms.autosuggestField({
            label: 'Bot token'|t('convergine-socialbuddy'),
            name: 'telegramBotToken',
            value: settings.telegramBotToken,
            instructions: 'Get this from @BotFather when creating your bot. Make sure to add this bot as an admin to your channel.'|t('convergine-socialbuddy'),
            suggestEnvVars: true,
        }) }}

        {% if settings.telegramChannelAccount and settings.telegramBotToken %}
            <div style="display: flex; align-items: center; margin-top: 20px; padding: 15px; background: #f0f8ff; border: 1px solid #b3d9ff; border-radius: 4px;">
                <span style="color: #0066cc; font-weight: bold;">✓ Connected to Telegram channel: @{{ settings.telegramChannelAccount }}</span>
                <button type="button" class="btn secondary" style="margin-left: 15px;" onclick="disconnectTelegram(event)">
                    Disconnect
                </button>
            </div>
        {% endif %}

        {% endif %}

    {% endnamespace %}

    <script>
        function disconnectTelegram(event) {
            if (!confirm('Are you sure you want to disconnect Telegram?')) {
                return;
            }

            var button = event.target;
            button.disabled = true;

            fetch("{{ siteUrl }}admin/convergine-socialbuddy/disconnect?platform=telegram", { method: "POST" })
                .then(response => response.json())
                .then(data => {
                    if (!data.connected) {
                        window.location.reload();
                    } else {
                        console.log('Failed to disconnect Telegram');
                        button.disabled = false;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    button.disabled = false;
                });
        }
    </script>
{% endblock %}